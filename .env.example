# =============================================================================
# Soulmaker environment example.
# Copy to ".env" (which is gitignored) and fill in. NEVER commit a real .env.
#
# SECURITY RULES (see SECURITY.md):
#  - NEVER put a Phantom recovery phrase / seed phrase anywhere, ever.
#  - NEVER use your main wallet. Live mode is burner-only.
#  - The default mode is PAPER. Live trading requires multiple explicit gates.
# =============================================================================

# Trading mode: PAPER | WATCH_ONLY | SIMULATION | DANGEROUS_BURNER_LIVE
SOULMAKER_MODE=PAPER

# Global halt. When "true", all trading intent is refused regardless of mode.
SOULMAKER_KILL_SWITCH=false

# Logging
SOULMAKER_LOG_LEVEL=info

# Read-only Solana RPC / WebSocket endpoints (no key custody implied).
# Prefer a private RPC; any embedded api-key is redacted from logs automatically.
SOULMAKER_RPC_URL=
SOULMAKER_WS_URL=

# -----------------------------------------------------------------------------
# LIVE MODE (DANGEROUS_BURNER_LIVE) — leave everything below UNSET for safety.
# All of these must be set, AND config gates must pass, before any live send.
# -----------------------------------------------------------------------------

# Out-of-band acknowledgement flag. Must be exactly "true" to arm live mode.
# SOULMAKER_I_UNDERSTAND_BURNER_RISK=false

# The NAME of the env var that holds the burner secret key — never the key here.
# The actual key is read at send-time only and never logged or persisted.
# SOULMAKER_BURNER_KEY_ENV=SOULMAKER_BURNER_SECRET

# The burner secret key itself (DANGEROUS_BURNER_ONLY). Fresh wallet, tiny funds.
# This is intentionally commented out; only set it on a throwaway burner.
# SOULMAKER_BURNER_SECRET=
